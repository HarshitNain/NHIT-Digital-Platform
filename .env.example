# ==============================================================================
# NHIT DIGITAL PLATFORM - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your credentials to activate live delivery
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EMAIL OTP DELIVERY - RESEND (RECOMMENDED: 3,000 Free Emails/Month)
# ------------------------------------------------------------------------------
# Sign up in 30 seconds at: https://resend.com
# Go to API Keys -> Create API Key -> Paste below:
RESEND_API_KEY=
# Default testing sender (No custom domain required for testing to your email):
EMAIL_SENDER="NHIT Security <onboarding@resend.dev>"

# ------------------------------------------------------------------------------
# 2. EMAIL OTP DELIVERY - GMAIL SMTP (100% FREE: 500 Emails/Day, Zero Signup)
# ------------------------------------------------------------------------------
# If you have a personal or corporate Google account:
# Step 1: Turn on 2-Step Verification at https://myaccount.google.com/security
# Step 2: Search for "App Passwords" or visit https://myaccount.google.com/apppasswords
# Step 3: Create an App Password for "NHIT Portal" (generates a 16-character code)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="NHIT Digital Platform Security"

# ------------------------------------------------------------------------------
# 3. EMAIL OTP DELIVERY - BREVO (FORMERLY SENDINBLUE: 300 Free Emails/Day)
# ------------------------------------------------------------------------------
# Sign up at https://brevo.com -> Settings -> SMTP & API -> API Keys
BREVO_API_KEY=

# ------------------------------------------------------------------------------
# 4. SMS OTP DELIVERY - TWILIO (Free $15 Trial Credit on Signup)
# ------------------------------------------------------------------------------
# Sign up at https://twilio.com -> Console Dashboard
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ------------------------------------------------------------------------------
# 5. SMS OTP DELIVERY - FAST2SMS (India Mobile Numbers +91)
# ------------------------------------------------------------------------------
# Sign up at https://fast2sms.com -> Dev API
FAST2SMS_API_KEY=

# ------------------------------------------------------------------------------
# 6. POSTGRESQL DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5433
DB_NAME=nhit_db
DB_USER=postgres
DB_PASSWORD=shristi
